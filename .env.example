# Port used by the Express server
PORT=3000

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/naviguard

# Comma-separated Overpass API endpoints. The backend tries each endpoint in order.
# Leave unset to use the built-in public provider fallback list.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Maximum time allowed for each Overpass request (milliseconds)
# OVERPASS_TIMEOUT_MS=35000
